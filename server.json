{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.coderneme/neme-world",
  "title": "neme.world",
  "description": "Publish a web game to neme.world: upload a preview, go live, roll back, read its play numbers.",
  "websiteUrl": "https://neme.world/developers",
  "icons": [
    { "src": "https://neme.world/static/icon-192.png", "mimeType": "image/png", "sizes": ["192x192"] },
    { "src": "https://neme.world/static/icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "repository": {
    "url": "https://github.com/coderneme/neme-cli",
    "source": "github"
  },
  "version": "0.7.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "neme-world",
      "version": "0.7.1",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        {
          "name": "NEME_TOKEN",
          "description": "An API token from your neme.world dashboard. Without one, a game is published for 24 hours with a link to claim it.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
